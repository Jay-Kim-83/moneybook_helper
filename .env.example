# 로컬 실행용 — start.bat 이 이 .env 를 자동으로 읽습니다.
ADMIN_PASSWORD=로그인에_사용할_비밀번호
PORT=3000

# === 아래는 Render 배포 시에만 사용 — 로컬에서는 주석(#)으로 두세요 ===
# NODE_ENV=production
# SESSION_SECRET=openssl_rand_hex_32_로_생성한_긴_문자열
# DATABASE_URL 설정 시 파일 대신 Postgres(Neon 등)에 저장 → 무료 플랜에서도 영구 보존
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
